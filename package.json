{
  "name": "agentdesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "prestart": "npm run config:check",
    "start": "next start --hostname 0.0.0.0",
    "config:check": "tsx scripts/check-config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:production": "node scripts/smoke-production.mjs",
    "test:ai:live": "tsx scripts/evaluate-ai.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@fontsource/inter": "^5.2.0",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "openai": "^6.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
