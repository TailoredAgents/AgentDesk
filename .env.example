# All variables are server-side. Never prefix secrets with NEXT_PUBLIC_.
# Copy to .env. Leaving the optional fields blank runs the local sample workspace.

# Optional locally; REQUIRED in production. Use Render's private connection string.
DATABASE_URL=

# Local-only embedded PostgreSQL storage; default .agentdesk/postgres.
# Run only one application/CLI process against a local PGlite directory at a time.
PGLITE_DATA_DIR=

# Optional. Without a key, saved sample reviews and internal updates still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional rewrite-specific model; blank uses OPENAI_MODEL.
OPENAI_REWRITE_MODEL=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Both REQUIRED in production. Both blank permits localhost development only.
# DEMO_PASSWORD must be at least 12 characters; use a unique strong password.
DEMO_PASSWORD=
# SESSION_SECRET must be at least 32 characters; generate a random secret.
SESSION_SECRET=

# Optional canonical origin for request validation. Include the scheme and port.
# Example local value: http://127.0.0.1:3000
# Set to your actual HTTPS address when deploying, especially with a custom domain.
APP_URL=

# Optional development/test switch. Normal development seeds an empty local DB.
# AGENTDESK_SKIP_AUTO_SEED=1

# Render provides PORT automatically; Next.js honors it on startup.
# PORT=3000
