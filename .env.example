# All variables are server-side. Never prefix secrets with NEXT_PUBLIC_.
# Copy to .env. Leaving the optional fields blank runs the local sample workspace.

# Optional locally; REQUIRED in production. Use Render's private connection string.
DATABASE_URL=

# Local-only embedded PostgreSQL storage; default .agentdesk/postgres.
# Run only one application/CLI process against a local PGlite directory at a time.
PGLITE_DATA_DIR=

# Optional. Without a key, saved sample reviews and internal updates still work.
OPENAI_API_KEY=
# GPT-6.1 Sol uses low reasoning for interactive drafts and rewrites.
OPENAI_MODEL=gpt-6.1-sol
# Optional rewrite-specific model; blank uses OPENAI_MODEL.
OPENAI_REWRITE_MODEL=
OPENAI_COPILOT_MODEL=
# Integrated sample-workspace Copilot. Set false to disable its UI and API.
AGENTDESK_COPILOT_ENABLED=true
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Both REQUIRED in production. Both blank permits localhost development only.
# DEMO_PASSWORD must be at least 12 characters; use a unique strong password.
DEMO_PASSWORD=
# SESSION_SECRET must be at least 32 characters; generate a random secret.
SESSION_SECRET=

# Optional canonical origin for request validation. Include the scheme and port.
# Example local value: http://127.0.0.1:3000
# Set to your actual HTTPS address when deploying, especially with a custom domain.
APP_URL=

# Optional development/test switch. Normal development seeds an empty local DB.
# AGENTDESK_SKIP_AUTO_SEED=1

# Render provides PORT automatically; Next.js honors it on startup.
# PORT=3000

# Optional private CRM pilot. Unset/0 keeps the sample presentation independent.
CRM_PILOT_ENABLED=0
# Dedicated Auth.js session secret (32+ characters); do not reuse SESSION_SECRET.
PILOT_AUTH_SECRET=
# Google OAuth web client; callback: APP_URL/api/pilot/auth/callback/google
PILOT_GOOGLE_CLIENT_ID=
PILOT_GOOGLE_CLIENT_SECRET=
# 64 hexadecimal characters representing 32 random bytes; keep a secure backup.
CRM_TOKEN_ENCRYPTION_KEY=
LOFTY_CLIENT_ID=
LOFTY_CLIENT_SECRET=
# Enable only after authorized development/production access is granted.
LOFTY_APP_APPROVED=0
# Enable ONLY after Lofty confirms and you verify OAuth state echo on this app.
LOFTY_STATE_VERIFIED=0
# Confirm /v1.0/me plus each selected endpoint grant in Lofty's developer portal.
# Start read-only. Add each write capability only after its controlled live test.
LOFTY_CAPABILITIES=leads.read,notes.read,tasks.read
# CRM content is sent to OpenAI only when this flag is enabled and an agent requests work.
CRM_AI_ENABLED=0
